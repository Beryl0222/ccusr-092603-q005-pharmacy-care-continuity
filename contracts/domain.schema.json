{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "药店健康陪伴责任链领域事件",
  "type": "object",
  "required": [
    "event_id",
    "event_type",
    "aggregate_type",
    "aggregate_id",
    "occurred_at",
    "version",
    "payload"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "event_type": {
      "type": "string",
      "enum": [
        "CONSENT_RECORDED",
        "PLAN_ACTIVATED",
        "SERVICE_CONFIRMED",
        "STORE_WITHDRAWN",
        "HANDOFF_COMPLETED"
      ]
    },
    "aggregate_type": {
      "type": "string",
      "enum": [
        "care_subject",
        "service_plan",
        "pharmacist_assignment",
        "continuity_handoff"
      ]
    },
    "aggregate_id": {
      "type": "string",
      "minLength": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "payload": {
      "type": "object"
    }
  },
  "payload_required_by_event": {
    "PLAN_ACTIVATED": [
      "plan_version",
      "pharmacist_id"
    ],
    "STORE_WITHDRAWN": [
      "effective_at",
      "reason"
    ],
    "HANDOFF_COMPLETED": [
      "from_store",
      "to_store"
    ]
  },
  "additionalProperties": false
}
